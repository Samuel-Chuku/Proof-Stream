# Copy to .env (gitignored). Never commit the real file.

# Arc Testnet RPC (chain 5042002)
ARC_RPC_URL=https://rpc.testnet.arc.network

# Read-only balance checks (pnpm check:chain / preflight:deploy). Address
# only — deployments are done by the human with their own key; this repo
# never holds it.
DEPLOYER_ADDRESS=

# StreamRegistry — how the agent discovers the streams it serves. Deployed
# once for the whole system (pnpm preflight:deploy, then DeployRegistry.s.sol).
# An employer deploys their own WorkStream, then announces it here; the agent
# reads StreamRegistered logs. Leave blank to keep the single-stream setup,
# where the agent just serves WORKSTREAM_ADDRESS.
REGISTRY_ADDRESS=
# The single-stream fallback, and THE AGENT WILL NOT START UNLESS ONE OF THESE
# TWO IS SET. Use REGISTRY_ADDRESS for a fleet, this for one stream, or both:
# the registry supplies the fleet and WORKSTREAM_ADDRESS is folded in as a seed
# entry, so an existing deployment keeps working the day the registry appears.
# The scripts that move money (withdraw, sweep, evidence, the seeder) read this
# one directly and have no registry path, so keep it set if you use them.
WORKSTREAM_ADDRESS=
# Block the registry was deployed in — where the log scan starts. Genesis would
# be slow and pointless. Defaults to the ProofStream demo registry's block.
REGISTRY_DEPLOY_BLOCK=
# How often the agent re-scans for newly registered streams (ms, default 60000).
REGISTRY_REFRESH_MS=
# How long after a milestone's end date the agent keeps certifying work (hours,
# default 4). Work merged just before the end still needs judging, verifying and
# signing, so a hard stop at the end date would strand pay the contributor had
# already earned. After this window the stream is no longer served at all —
# close it to reclaim the unspent budget.
MILESTONE_GRACE_HOURS=4

# Where the runtime ledgers are written: verdicts.jsonl and reviews.jsonl.
# Leave BLANK for local development and it defaults to agent/ in the checkout.
#
# SET THIS ON ANY DEPLOYED HOST, to a path outside the repo:
#   PROOFSTREAM_LOG_DIR=/var/lib/proofstream
#
# These files are written by the running agent while the same directory is a
# deploy target. Leaving them in the checkout means every git operation on that
# host competes with live state. It has already cost eight days of verdicts.
PROOFSTREAM_LOG_DIR=

# Reads pull request diffs and the repository's files after a merge. A classic
# PAT with `repo`, or a fine-grained token with Contents and Pull requests read
# access on the repos you stream. Both agents fetch their own copy of the
# evidence rather than trusting what the buyer sends, so this is the one
# credential the two of them share.
GITHUB_TOKEN=

# MASTER webhook secret, for the MANUAL path. Each stream's actual secret is
# derived from this plus its address, so nothing is stored and every stream gets
# a different one. NEVER give this value to an employer — give them the output
# of `pnpm webhook:secret <stream>`, which is that stream's secret alone.
GITHUB_WEBHOOK_SECRET=

# --- GitHub App (optional; the manual path above works without it) ----------
# A GitHub App has ONE webhook URL and ONE secret. Installing it on a repo is
# what subscribes that repo, so there are no per-repo webhooks to create, and
# deliveries for every installation arrive at POST /webhook/github carrying the
# repository name — which is all the registry needs to route them.
#
# Register at github.com/settings/apps/new with exactly three read permissions
# (Contents, Pull requests, Metadata) and the Pull request event.
# Keep this secret DISTINCT from GITHUB_WEBHOOK_SECRET: rotating one in GitHub's
# UI would otherwise invalidate every derived per-stream secret.
GITHUB_APP_ID=
# The App's public slug, the <slug> in github.com/apps/<slug>. Not a secret.
# SET THIS IF YOU REGISTER YOUR OWN APP: it defaults to `proofstream`, so left
# blank the web app's install button points at ProofStream's App rather than
# yours, and the install appears to work while subscribing nothing you can read.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
# Path to the App's .pem. Never commit it — *.pem is gitignored.
GITHUB_APP_PRIVATE_KEY_PATH=

# The public URL GitHub delivers to, tunnel or VPS, e.g. https://agent.example.com
# This is the single knob for where GitHub reaches the agent, so the tunnel can be
# swapped for a host without touching code, and `pnpm webhook:secret <stream>`
# prints the full payload URL from it. The agent still starts without it and just
# prints a placeholder where the URL should be, so a blank here shows up as a
# webhook you never registered rather than as an error.
AGENT_INGRESS_URL=

# Encrypts the web app's login cookie. openssl rand -hex 32
SESSION_SECRET=

# Circle developer-controlled wallets (attestor + verifier agents).
# Create a testnet API key in the Circle console. ENTITY_SECRET is
# account-level: if your Circle account already has one registered, reuse it;
# otherwise register one per Circle's docs. Then run `pnpm circle:setup`.
CIRCLE_API_KEY=
ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# Attestor agent — Circle wallet; signs EIP-712 attestations and sends unlock
# txs itself. Filled by pnpm circle:setup.
AGENT_WALLET_ID=
AGENT_ADDRESS=

# Verifier agent — Circle wallet, Phase 3. Filled by pnpm circle:setup.
# The seller only ever needs the address: Circle Gateway credits it, and no
# key for it is used in this repo. VERIFIER_WALLET_ID is kept for symmetry.
VERIFIER_WALLET_ID=
VERIFIER_ADDRESS=

# Where the attestor listens (default 8787): webhook ingress, plus /health and
# the /events feed the dashboard and `pnpm watch` read.
PORT=

# Where the attestor buys its second opinion. Defaults suit both processes on
# one host; point VERIFIER_URL elsewhere to split them across machines.
VERIFIER_PORT=8788
VERIFIER_URL=http://localhost:8788/verify

# A different vendor from AGENT_MODEL on purpose — a second opinion from the
# same model is not a second opinion.
#
# Qualify any replacement on a diff that does NOT satisfy the milestone, not
# just one that does. Two models have now been rejected here, and both judged
# the easy case perfectly before failing the mismatch: they spend the whole
# max_tokens budget reasoning and return nothing, which arrives as "not valid
# JSON". x402 settles the fee BEFORE the handler runs, so each of those is paid
# for in full. `pnpm review:test <pr> "<a milestone the diff fails>"` is the
# check, and it costs nothing on a free slug.
#
# Rejected for exactly that: google/gemini-2.5-pro, cohere/north-mini-code:free,
# nvidia/nemotron-3-super-120b-a12b:free.
#
# Paid slug (drop `:free`) is the same model on dedicated capacity, away from
# the shared free pool's 429s — ~$0.0002 a review against the $0.005 fee.
VERIFIER_MODEL=poolside/laguna-s-2.1:free

# --- LLM provider: bring your own ------------------------------------------
# Any OpenAI-compatible endpoint that serves POST {LLM_BASE_URL}/chat/completions.
# Defaults to OpenRouter. Examples:
#   LLM_BASE_URL=http://localhost:11434/v1        # Ollama
#   LLM_BASE_URL=https://api.groq.com/openai/v1   # Groq
#   LLM_BASE_URL=https://api.together.xyz/v1      # Together
#   LLM_BASE_URL=https://api.openai.com/v1        # OpenAI
# Set AGENT_MODEL and VERIFIER_MODEL to slugs THAT PROVIDER serves — a model
# name that only exists on OpenRouter is the usual failure after switching.
LLM_BASE_URL=
# Preferred name. OPENROUTER_API_KEY still works so existing setups keep running.
# A local provider that needs no key still wants a placeholder here.
LLM_API_KEY=

# Defaults are FREE models, validated against a known-good and a known-bad diff.
# Override for a recorded demo where reasoning quality is on screen.
AGENT_MODEL=openai/gpt-oss-20b:free

# THE RELEASE GATE (default 0.7), applied twice: to the attestor's own verdict
# and again to the verifier's. Below it the agent releases nothing and stops.
# Nothing reviews a held judgment. There is no queue and no appeal, the work
# just waits for a later pull request to be judged again. Lowering this buys
# throughput with judgments the agent was not sure of, which is the one trade
# this system exists to refuse.
AGENT_CONFIDENCE_THRESHOLD=

# --- Passkey wallets for CONTRIBUTORS (optional) -----------------------------
# Circle Modular Wallets. A contributor with no wallet onboards with a passkey —
# the device's fingerprint or face — and gets a smart account that can receive
# and withdraw pay, with Circle sponsoring the gas.
#
# CONTRIBUTOR-ONLY, and that is architectural. A modular wallet is ERC-4337 and
# a user operation calls an EXISTING address; there is no contract-creation
# path. Deploying the WorkStream is what makes someone its employer, so an
# employer must bring a browser wallet.
#
# These come from the Circle Console (API & Client Keys), and note the passkey
# DOMAIN NAME is a single account-level setting that must match the client key's
# Allowed Domain exactly — so a Circle account already serving another product's
# passkeys cannot also serve this one. Use a separate account. Nothing here
# touches CIRCLE_API_KEY or the agents' developer-controlled wallets.
#
# Leave both blank and the passkey UI simply does not appear.
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=
NEXT_PUBLIC_CIRCLE_CLIENT_URL=

# Contributor — calls withdraw() to the allowlisted payee
CONTRIBUTOR_ADDRESS=
CONTRIBUTOR_PRIVATE_KEY=

# (VAULT_ADDRESS / VAULT_PRIVATE_KEY were removed on 2026-08-05. WorkStream used
#  to divert 15% of every release to a "vesting vault" that had no schedule, no
#  cliff and no way for the contributor to claim it — so it was withholding, not
#  vesting. The contract now credits the contributor in full and nothing reads
#  those variables.)

# Stream terms — the EMPLOYER's numbers, not the protocol's. All optional;
# Deploy.s.sol falls back to the demo defaults shown. They freeze on-chain at
# deploy, and every consumer then reads them from the contract.
# A milestone does NOT start until its full budget is deposited.
#   STREAM_BUDGET            USDC for milestone 1   (default 40000000 = 40 USDC)
#   STREAM_DURATION_SECONDS  accrual window         (default 21600 = 6 hours)
#   STREAM_MILESTONE         first milestone text
#   POLICY_MAX_TRANCHE       ceiling on the entitlement ONE attestation may
#                            create (default = the whole budget)
#   POLICY_DAILY_UNLOCK_CAP  same ceiling per UTC day (default = the whole budget)
#   POLICY_PAYEE             only address withdraw may pay (default CONTRIBUTOR_ADDRESS)
#
# On POLICY_MAX_TRANCHE: setting it below the budget does not make a stream
# safer, it makes an honest contributor poorer. The agent certifies a milestone
# ONCE, so a ceiling of a quarter caps them at a quarter and the rest refunds to
# you on close. Money still only leaves at the speed the stream accrues — the
# clock is a second rate limit no key can bypass — so what actually bounds a
# compromised agent is the daily cap and funding one milestone at a time.
STREAM_BUDGET=
STREAM_DURATION_SECONDS=
STREAM_MILESTONE=
POLICY_MAX_TRANCHE=
POLICY_DAILY_UNLOCK_CAP=
POLICY_PAYEE=

# --- missed-webhook recovery ------------------------------------------------
# GitHub discards a delivery after a few failed retries, so a PR merged while
# the agent was down is never judged. On startup the agent looks back over this
# window for merged PRs with no verdict and puts them through the same gates.
# BOTH BOUNDS MATTER: this spends money without being asked, and an unbounded
# lookback against a repo with history would judge years of old work on first
# run. Set either to 0 to disable.
RECONCILE_LOOKBACK_HOURS=24
RECONCILE_MAX_PRS=5

# --- web app (client-side; never put a secret behind NEXT_PUBLIC_) ----------
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_AGENT_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Where the dashboard reads the agents' logs from. Unset falls back to reading
# agent/*.jsonl off disk, which only works if the web app and agent share a host.
AGENT_EVENTS_URL=
# How often `pnpm watch` polls that same feed (ms, default 5000). The watcher
# also falls back to the public agent URL when AGENT_EVENTS_URL is unset, so it
# runs on a second machine with no .env at all.
WATCH_INTERVAL_MS=
