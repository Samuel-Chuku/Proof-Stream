# Copy to .env (gitignored). Never commit the real file.

# Arc Testnet RPC (chain 5042002)
ARC_RPC_URL=https://rpc.testnet.arc.network

# Read-only balance checks (pnpm check:chain). Deployments are done by the
# human with their own key — this repo never sends a deploy from here.
DEPLOYER_PRIVATE_KEY=

# Attestor agent — signs EIP-712 attestations and sends unlock txs itself
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=

# Contributor — calls withdraw() to the allowlisted payee
CONTRIBUTOR_ADDRESS=
CONTRIBUTOR_PRIVATE_KEY=

# Vesting vault — receives the 15% tranche split
VAULT_ADDRESS=
VAULT_PRIVATE_KEY=
