{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "skillVersion", "proofstreamCommit", "releaseStatus", "chain", "addresses"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "skillVersion": { "type": "string" },
    "proofstreamCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "releaseStatus": { "enum": ["experimental", "stable"] },
    "chain": { "type": "object", "required": ["name", "chainId"], "properties": { "name": { "type": "string" }, "chainId": { "type": "integer", "minimum": 1 } } },
    "addresses": { "type": "array", "items": { "type": "object", "required": ["contract", "address", "chainId", "status", "source"], "properties": { "contract": { "type": "string" }, "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }, "chainId": { "type": "integer" }, "status": { "type": "string" }, "source": { "type": "string" } } } }
  }
}
