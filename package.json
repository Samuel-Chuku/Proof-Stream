{
  "name": "proofstream",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "check:chain": "tsx --env-file=.env scripts/check-chain.ts",
    "circle:setup": "tsx --env-file=.env scripts/circle-setup.ts",
    "preflight:deploy": "tsx --env-file=.env scripts/preflight-deploy.ts",
    "preflight:agent": "tsx --env-file=.env scripts/preflight-agent.ts",
    "preflight:verifier": "tsx --env-file=.env scripts/preflight-verifier.ts",
    "preflight:withdraw": "tsx --env-file=.env scripts/preflight-withdraw.ts",
    "preflight:register": "tsx --env-file=.env scripts/preflight-register.ts",
    "webhook:secret": "tsx --env-file=.env scripts/webhook-secret.ts",
    "preflight:drain": "tsx --env-file=.env scripts/preflight-drain.ts",
    "sweep": "tsx --env-file=.env scripts/sweep.ts",
    "withdraw": "tsx --env-file=.env scripts/withdraw.ts",
    "agent:dev": "tsx --env-file=.env agent/src/index.ts",
    "verifier:dev": "tsx --env-file=.env agent/src/verifier/index.ts",
    "gateway:deposit": "tsx --env-file=.env scripts/gateway-deposit.ts",
    "verify:once": "tsx --env-file=.env scripts/buy-verification.ts",
    "web:dev": "bash -c 'set -a; source .env; set +a; cd web && exec ./node_modules/.bin/next dev'",
    "web:build": "bash -c 'set -a; source .env; set +a; cd web && exec ./node_modules/.bin/next build'",
    "verdict:test": "tsx --env-file=.env scripts/test-verdict.ts",
    "review:test": "tsx --env-file=.env scripts/test-review.ts",
    "test:amounts": "tsx --test config/test/amounts.test.ts",
    "sync:artifacts": "tsx scripts/sync-artifacts.ts",
    "seed": "tsx --env-file=.env scripts/demo-seed.ts",
    "evidence": "tsx --env-file=.env scripts/evidence.ts",
    "test:repo": "tsx --test config/test/repo.test.ts",
    "logs:pull": "tsx --env-file=.env scripts/pull-logs.ts",
    "test:json": "tsx --test agent/test/extract-json.test.ts",
    "test:serialize": "tsx --test agent/test/serialize.test.ts",
    "test:poll": "tsx --test agent/test/poll.test.ts",
    "test:caps": "tsx --test web/test/caps.test.ts",
    "test:metering": "tsx --test agent/test/metering.test.ts",
    "test:allowlist": "tsx --test web/test/author-allowlist.test.ts",
    "test:create-stream": "tsx --test web/test/create-stream.test.ts",
    "test:sandbox": "tsx --test agent/test/sandbox.test.ts",
    "test:correctness": "tsx --test agent/test/correctness.test.ts",
    "test:suite-cache": "tsx --test agent/test/suite-cache.test.ts",
    "test:earner": "tsx --test agent/test/earner.test.ts",
    "test:ceiling": "tsx --test agent/test/ceiling.test.ts",
    "test:reconcile": "tsx --test agent/test/reconcile-judged.test.ts",
    "test:failover": "tsx --test agent/test/llm-failover.test.ts",
    "test:bind": "tsx --test agent/test/bind.test.ts",
    "test:withdraw-cap": "tsx --test web/test/withdraw-cap.test.ts",
    "test:ago": "tsx --test web/test/ago.test.ts",
    "test:sweep": "tsx --test agent/test/reconcile-sweep.test.ts",
    "test:resume": "tsx --test agent/test/resume.test.ts",
    "test:alerts": "tsx --test agent/test/alerts.test.ts",
    "test:email": "tsx --test agent/test/email.test.ts",
    "watch": "tsx --env-file-if-exists=.env scripts/watch.ts",
    "stream:status": "tsx --env-file=.env scripts/stream-status.ts",
    "skill:generate": "pnpm --filter proofstream-integration-skill generate",
    "skill:check": "pnpm --filter proofstream-integration-skill generate:check && pnpm --filter proofstream-integration-skill test",
    "skill:test": "pnpm --filter proofstream-integration-skill test",
    "skill:creative-check": "pnpm --filter proofstream-integration-skill creative-check --json",
    "skill:pack": "pnpm --filter proofstream-integration-skill pack:release",
    "skill:install-test": "node proofstream-skill/test/install.test.mjs",
    "skill:release-dry-run": "pnpm --filter proofstream-integration-skill generate:check && pnpm --filter proofstream-integration-skill test && pnpm --filter proofstream-integration-skill pack:release",
    "probe:policy": "tsx --env-file=.env scripts/probe-policy.ts",
    "revert:prepare": "tsx --env-file=.env scripts/policy-revert.ts",
    "sandbox:smoke": "tsx --env-file=.env scripts/sandbox-smoke.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/x402-batching": "^3.2.0",
    "@proofstream/config": "workspace:*",
    "@x402/core": "^2.20.0",
    "@x402/evm": "^2.20.0",
    "express": "^5.2.1",
    "viem": "^2.21.0"
  }
}
